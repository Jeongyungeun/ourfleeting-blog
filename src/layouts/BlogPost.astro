---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, tags = [] } = Astro.props;

// JSON-LD 구조화 데이터
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	"headline": title,
	"description": description,
	"image": heroImage ? new URL(heroImage.src, Astro.site).toString() : undefined,
	"datePublished": pubDate.toISOString(),
	"dateModified": updatedDate ? updatedDate.toISOString() : pubDate.toISOString(),
	"author": {
		"@type": "Organization",
		"name": SITE_TITLE,
		"url": Astro.site
	},
	"publisher": {
		"@type": "Organization",
		"name": SITE_TITLE,
		"url": Astro.site
	},
	"mainEntityOfPage": {
		"@type": "WebPage",
		"@id": Astro.url.toString()
	},
	"keywords": tags.join(", ")
};
---

<Layout
	title={title}
	description={description}
	image={heroImage}
	type="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	tags={tags}
>
	<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	<article class="max-w-3xl mx-auto">
		<div class="mb-8">
			{
				heroImage && (
					<div class="aspect-video w-full overflow-hidden rounded-3xl mb-8 shadow-soft">
						<Image
							width={1020}
							height={510}
							src={heroImage}
							alt=""
							class="w-full h-full object-cover"
						/>
					</div>
				)
			}
			<div class="text-center">
				<div
					class="flex items-center justify-center gap-2 text-sm text-slate-500 mb-4"
				>
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<div class="italic">
								(Updated on <FormattedDate date={updatedDate} />
								)
							</div>
						)
					}
				</div>
				<h1
					class="text-3xl md:text-5xl font-bold text-slate-900 mb-4 tracking-tight"
				>
					{title}
				</h1>
				<hr
					class="w-20 h-1 bg-primary-500 mx-auto rounded-full border-0"
				/>
			</div>
		</div>

		<div
			class="prose prose-lg prose-slate mx-auto prose-headings:font-semibold prose-a:text-primary-600 prose-a:no-underline hover:prose-a:underline prose-img:rounded-2xl"
		>
			<slot />
		</div>
	</article>
</Layout>
